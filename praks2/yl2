#!/bin/bash
# Ülesanne 3 - väljastab kuupäeva ja kellaajaga seotud info ning kalendri.
# Kasutatud: date, cal, tr, sed, uptime

echo "--- Kuupäev ja kellaaeg ---"
echo "Kellaaeg: $(date +%H:%M:%S)"
echo "Kuupäev: $(date +%d.%m.%Y)"
echo "Nädalapäev: $(date +%A)"
echo "Kuu: $(date +%B | tr '[:lower:]' '[:upper:]')"
echo "Päev aasta algusest: $(date +%j | sed 's/^0*//')"
echo "Nädala number: $(date +%V)"
echo "Ajavöönd: $(date '+%Z (UTC%z)')"
echo "Unix-aeg: $(date +%s)"
echo "Süsteem on töötanud: $(uptime -p)"

echo
echo "--- Jooksva kuu kalender ---"
cal

# Lisatud: mitu päeva on aasta lõpuni.
# 10# sunnib arvu kümnendsüsteemi, muidu tõlgendaks bash ees oleva nulliga
# päevanumbrit (nt 087) kaheksandsüsteemis ja viskaks vea.
LOPP=$(date -d "31 dec" +%j)
TANA=$(date +%j)
echo
echo "Aasta lõpuni on jäänud: $((10#$LOPP - 10#$TANA)) päeva"

# Lisatud: kalender koos nädalanumbritega ja eelmine/järgmine kuu kõrvuti
echo
echo "--- Kalender nädalanumbritega ---"
ncal -bw
echo
echo "--- Eelmine, jooksev ja järgmine kuu ---"
cal -3
